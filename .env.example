# ============================================================
#  Copiá este archivo como ".env" y completá los valores.
#  NUNCA subas el archivo .env a GitHub.
# ============================================================

# --- Obligatorias ---

# Token de acceso de la WhatsApp Cloud API.
# Para pruebas: el token temporal (dura 24 h) de developers.facebook.com > tu app > WhatsApp > API Setup.
# Para producción: un token PERMANENTE de un "System User" (Business Settings > Users > System users).
TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID del número de teléfono (NO es el número en sí). Está en WhatsApp > API Setup > "Phone number ID".
PHONE_NUMBER_ID=123456789012345

# Texto secreto que inventás vos. Tiene que ser IGUAL al que cargues en Meta al configurar el webhook.
VERIFY_TOKEN=mi_token_secreto_de_verificacion

# --- Opcionales (recomendadas) ---

# App Secret (App settings > Basic). Si lo cargás, el bot verifica que cada POST venga realmente de Meta.
APP_SECRET=

# Número de un asesor (formato internacional sin "+", ej: 5493511234567) para avisarle
# cada vez que un cliente pide hablar con una persona.
ADVISOR_PHONE=

# Horario de atención que se muestra al derivar con un asesor.
HORARIO_ATENCION=de lunes a viernes de 9 a 18 h

# Horas que el bot queda "en silencio" mientras el cliente habla con un asesor.
HANDOFF_HOURS=24

# Versión de la Graph API de Meta.
GRAPH_API_VERSION=v23.0

PORT=3000
